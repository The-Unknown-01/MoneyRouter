# DeepSeek 接入配置（复制为 .env 后按需填写；不要把真实密钥提交到仓库）
#
# 密钥读取顺序（与 Go 侧对齐）：
#   1) DEEPSEEK_API_KEY    直接给密钥内容
#   2) DEEPSEEK_API_KEY_FILE  指向存放密钥的文件（默认 ../.env/deepseek_api.key）
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=../.env/deepseek_api.key

# base URL：DEEPSEEK_API_BASE（本仓标准名）与 DEEPSEEK_BASE_URL（Go 侧 agent.go 用的名字）都认，
# 同时给出时前者优先。
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── 思考模式（官方默认开启）────────────────────────────────────────────────
# 开关：enabled / disabled（disabled 仅作应急降级，会牺牲推理质量）
DEEPSEEK_THINKING=enabled
# 推理力度：low / high / max（官方默认 high；访谈是多轮交互，这里默认 low）
DEEPSEEK_REASONING_EFFORT=low

# ── 生成与重试 ────────────────────────────────────────────────────────────
# 思考模式下推理过程计入 completion token，上限必须留足，否则 JSON 会被截断
DEEPSEEK_MAX_TOKENS=4096
# 思考模式更慢，超时放宽
DEEPSEEK_TIMEOUT_S=120
# SDK 层重试：只覆盖网络错误与 5xx
DEEPSEEK_MAX_RETRIES=2
# 结构化输出（空内容/解析失败）的额外重试次数；总尝试 = 该值 + 1
DEEPSEEK_STRUCTURED_RETRIES=2

# ── 采样（注意：思考模式下 temperature 官方明确无效，因此该模式下不会发送）──
# DEEPSEEK_TEMPERATURE=0.3
# 思考模式下 top_p 才生效，有效区间 0.95–1.0，发送前会自动钳制
# DEEPSEEK_TOP_P=


# ── 联网检索：博查 Web Search（金融情况 Agent 用）───────────────────────────
# 注册后在 https://open.bochaai.com/ 创建 API Key；新用户有 1000 次免费额度。
# 密钥读取顺序与 DeepSeek 同款：
#   1) BOCHA_API_KEY       直接给密钥内容
#   2) BOCHA_API_KEY_FILE  指向存放密钥的文件（默认 ../.env/bocha_api.key）
BOCHA_API_KEY=
BOCHA_API_KEY_FILE=../.env/bocha_api.key
BOCHA_BASE_URL=https://api.bochaai.com

# 单条检索意图取回的材料条数（官方上限 10）
BOCHA_COUNT=8
# 默认时间范围：noLimit / oneDay / oneWeek / oneMonth / oneYear
# （模型通常会在检索意图里逐条指定，这里只是兜底）
BOCHA_FRESHNESS=noLimit
BOCHA_TIMEOUT_S=30
# 并发检索线程数：目标 VPS 只有 1 vCPU，不要开大
BOCHA_MAX_PARALLEL=4
# 检索轮数上限：首轮 + 反思后最多补一轮（1–3）
SEARCH_MAX_ROUNDS=2
# 是否在入库前剔除论坛/自媒体类材料（默认开启）。
# 判定按 URL 与站点名：官方发布、主流财经媒体保留并按可信度排序；论坛、问答、
# 自媒体平台（搜狐号 /a/、大风号 /c/、网易号 /dy/article/、头条号等）剔除。
# 地缘政治、突发事件这类题材里它们的占比很高，混进简报会拖垮整份材料的可信度。
# 若某轮材料**全部**被判为低级别，则原样保留（只排最后），不会把整轮打空。
# 设 false 可只排序不剔除，便于排查召回质量。
SEARCH_DROP_LOW_TIER=true


# ── 结构化行情/宏观数据：AKShare（金融情况 Agent 用）─────────────────────────
# 免密钥。首次运行前请安装依赖：pip install -r requirements.txt
# 在 1 vCPU / 1GiB 的目标机器上，AKShare（含 pandas）是最重的一项依赖。
MARKET_DATA_ENABLED=true

# 取数整体超时与重试（东财全球指数等接口很不稳定，故重试 3 次）
MARKET_DATA_TIMEOUT_S=20
MARKET_DATA_RETRIES=3

# 进程内缓存秒数。取数全量约 30 秒，而同一份数据一天内几乎不变；
# 多用户场景务必保留缓存，否则每个请求都会重打一遍数据源。设为 0 可关闭。
MARKET_DATA_CACHE_TTL_S=21600

# 落盘缓存：源站整体故障时的兜底数据（legulegu 会整组 504，一旦它就绪过一次，
# 之后挂掉仍能出简报）。**只在实时取数失败时启用**，数据时点由各指标的 as_of
# 如实反映，并在简报提示里注明"使用的是缓存数据"。设为 0 / 目录留空即关闭。
# 目录的相对路径以 agent/ 为基准。注意：这个目录必须被 .gitignore 忽略。
MARKET_DATA_DISK_TTL_S=604800
MARKET_DATA_CACHE_DIR=.cache/market_data

# 只取指定指标（逗号分隔的 key）；留空 = 全部。常用 key 见
# src/moneyrouter_agent/domain/finance.py 的 METRIC_SPECS。
# 例：MARKET_DATA_INCLUDE=cn_10y_yield,cn_cpi_yoy,hs300_pe_ttm,hs300_erp
MARKET_DATA_INCLUDE=


# ── 本月实况 Agent：关注点探测阈值（可选，留空用默认）────────────────────────
# 某分类 ≥「上月/近三月均值/预算」× 该倍数即视为"明显偏多"，生成关注点
MONTH_OVER_BASELINE_FACTOR=1.3
# 单笔 ≥ 该金额（分，默认 100000 = 1000 元）视为一次性大额
MONTH_ONE_OFF_MIN_CENTS=100000
# 或单笔 ≥ 本月收入 × 该比例，也视为一次性大额
MONTH_ONE_OFF_INCOME_RATIO=0.10
# 分类显著偏离的百分比阈值（供展示参考）
MONTH_BIG_DELTA_PCT=20
# 本月净攒 < 计划攒 × 该系数即提示"目标落后"
MONTH_GOAL_OFF_TRACK_FACTOR=0.8
# 某笔已有投资本月亏损 ≥ 该金额（分，默认 100000 = 1000 元）才追问原因
MONTH_INVEST_LOSS_MIN_CENTS=100000
# 历史留档目录（相对 agent/）；落定的月份存这里，下个月自动当基线用。留空 = 关闭留档
MONTH_HISTORY_DIR=.data/months
# 做基线（上月 / 近三月均值 / 累计已攒）时最多回看多少个月
MONTH_HISTORY_LIMIT=3


# ── 总结 Agent（后馈）：落档位置（可选，留空 = 关闭对应留档）────────────────────
# 经验包：按 kind 归并、版本递增，供方案生成注入
SUMMARY_EXPERIENCE_DIR=.data/experience
# 画像事件日志：append-only，已写入的条目永不改写
SUMMARY_EVENT_DIR=.data/profile_events
# 月度复盘：按期间覆盖
SUMMARY_SUMMARY_DIR=.data/summaries
# 用户标识（决定文件名）
SUMMARY_USER=default


# ── 方案生成 Agent：工具编排（可选，留空用默认）────────────────────────────
# AI 自主调用计算工具的最大轮数（防止死循环；1-12）
PLAN_MAX_TOOL_ROUNDS=4
# 工具循环是否开启思考模式。默认 false —— 思考模式 + tools 时 reasoning_content 必须回传，
# 而客户端不回传会导致 400；关闭思考既避开该问题，也更省 token 与延迟。
PLAN_TOOLS_THINKING=false
